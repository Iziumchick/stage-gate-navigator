# Local prototype defaults; never commit the real .env.
# Exact bootstrap administrator mailbox; may be the private operator address.
# This exception never enables external study-account registration.
ADMIN_EMAIL=
ADMIN_PASSWORD=
APP_ENV=development
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
DATA_RETENTION_DAYS=90

# Complete with actual information before a public real-data test.
# Controller is the private operator, NOT OTH Regensburg.
PRIVACY_CONTROLLER=
PRIVACY_CONTACT=
PRIVACY_ADDRESS=
PRIVACY_HOSTING_PROVIDER=
PRIVACY_HOSTING_COUNTRY=
PRIVACY_AUTHORITY=
# Describe actual hosting/security logs separately from backup arrangements.
PRIVACY_LOG_POLICY=
PRIVACY_BACKUP_POLICY=
PRIVACY_MAIL_PROVIDER=
PRIVACY_MAIL_RETENTION=
PRIVACY_REVIEWED=false

# Institutional mailbox verification is mandatory in production.
# Keep false for the local fictional demo until real SMTP is configured.
REQUIRE_INSTITUTIONAL_EMAIL=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Public deployment requires APP_ENV=production, COOKIE_SECURE=true,
# explicit HTTPS APP_ORIGINS, all PRIVACY_* fields and PRIVACY_REVIEWED=true.
